# ⠀⠈⠻⣦⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣶⠚⠋⠙⠓⢶⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⣤⠞⠁⠀
# ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⠛⠲⠖⠛⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀

NAME 		= c_light_system_library.a

SRCDIR 		= src
OBJDIR 		= .obj
INCDIR 		= include
LIBDIR 		= libs

CLCDIR 		= $(LIBDIR)/core
CLCINC		= $(CLCDIR)/include
CLCLIB 		= $(CLCDIR)/c_light_core_library.a

SRCS 		= $(addprefix $(SRCDIR)/, \
				test.c)

OBJS 		= $(patsubst %.c,$(OBJDIR)/%.o,$(SRCS))
DEPS 		= $(OBJS:.o=.d)

CFLAGS 		= -Werror -Wextra -Wall -pedantic -MD -MP -I $(INCDIR) -I $(CLCINC) -g3
AR 			= ar -rcs
DEPFLAGS 	= -MMD -MP

$(NAME): 	$(OBJS) $(CLCLIB)
			$(AR) $(NAME) $(OBJS)

$(OBJDIR)/%.o: $(SRCDIR)/%.c
			@mkdir -p $(dir $@)
			$(CC) $(CFLAGS) $(DEPFLAGS) -c $< -o $@

$(CLCLIB):	FORCE
			$(MAKE) -C $(CLCDIR)

all: 		$(NAME)

clean:
			rm -rf $(OBJDIR)
			$(MAKE) clean -C $(CLCDIR)

fclean:		clean
			rm -f $(NAME)
			$(MAKE) fclean -C $(CLCDIR)

re: 		fclean
			make all

-include 	$(DEPS)

.PHONY: 	all clean fclean re FORCE